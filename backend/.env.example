# Gemma via Ollama (optional): `ollama pull gemma3`
OLLAMA_URL=http://localhost:11434/api/generate
GEMMA_MODEL=gemma3:4b
ALLOWED_ORIGIN=http://localhost:5173

# Auth. Generate a secret: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=change-me
# true = OTP codes print in the server console and show on screen. Set false in production.
DEV_MODE=true
# true = "Try the demo" button works (guest account, no sign-up). Fine for demos, off for production.
DEMO_MODE=true
# Google sign-in: OAuth Web client ID from console.cloud.google.com (same value goes in frontend/.env)
GOOGLE_CLIENT_ID=
# Email OTP (any SMTP provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMS OTP (Twilio)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
